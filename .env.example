# Never put real credentials in Git or the web directory.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/defaultdb
DB_SSL_ROOT_CERT=config/ca.pem
DB_SCHEMA=nro_web
DB_POOL_MAX=3
MAX_PLAYERS=5
PORT=8080
# Optional registration code for your group. Empty means open registration.
INVITE_CODE=
# Optional exact HTTPS origin, e.g. https://your-game.onrender.com
PUBLIC_ORIGIN=
